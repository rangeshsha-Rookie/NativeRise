# Server Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Atlas URI (or local for dev/testing)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nativerise?retryWrites=true&w=majority

# Authentication
JWT_SECRET=nativerise_super_secure_jwt_secret_key_change_me_in_production_min32chars
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_mockkeyid1234
RAZORPAY_KEY_SECRET=mockkeysecret123456789
RAZORPAY_WEBHOOK_SECRET=

# Google Gemini API
GEMINI_API_KEY=mock_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary
CLOUDINARY_CLOUD_NAME=mock_cloud
CLOUDINARY_API_KEY=mock_api_key
CLOUDINARY_API_SECRET=mock_api_secret

# Geo & Routing
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=NativeRise/1.0 (contact: dev@nativerise.test)
OSRM_BASE_URL=https://router.project-osrm.org

# Feature Flags & Demo
DEMO_TOOLS_ENABLED=true
STRICT_GEOFENCE=false
SEED_DEMO_PASSWORD=Demo@1234
